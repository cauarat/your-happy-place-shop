STRIPE_SECRET_KEY=sk_test_...
PORT=4242

# Voice assistant (ElevenLabs).
#
# Read only by scripts/generate-voice.ts, which records the fixed lines as MP3
# files at build time. Deliberately without a VITE_ prefix: that prefix is what
# would put the key into the browser bundle.
#
# The runtime path does not use this file at all — the Edge Function reads its
# own copy from the Supabase secret of the same name:
#
#     npx supabase secrets set ELEVENLABS_API_KEY=...
ELEVENLABS_API_KEY=

# Optional. Which voice the pre-generated lines are recorded in. Defaults to
# DEFAULT_VOICE_ID in src/lib/voiceLines.ts; set the same id in the admin panel
# (AI Stylist Control → Voice Assistant) so the runtime lines match.
ELEVENLABS_VOICE_ID=

# Firecrawl. Read only by scripts/import-crawl.ts, and only when it is given
# --url: with a key here the importer crawls a shop itself instead of reading an
# export you saved by hand.
#
# Deliberately without a VITE_ prefix: that prefix is what would put the key
# into the browser bundle. Get a key at https://firecrawl.dev.
FIRECRAWL_API_KEY=

# Who may open the admin portal, comma-separated.
#
# Public on purpose — it reaches the browser bundle, and knowing who runs the
# shop reveals nothing. It decides what the admin screens *show*, not who gets
# in: anyone can edit their own JavaScript. The lock that matters is the
# ADMIN_EMAILS secret on the Edge Function, which must hold the same addresses:
#
#     npx supabase secrets set ADMIN_EMAILS=someone@example.com
#
# Unset means nobody, so a half-finished deploy locks the door rather than
# leaving it open.
VITE_ADMIN_EMAILS=
